<% if @event.vps -%>
VPS <%= @event.vps.hostname %> (#<%= @event.vps.id %>): <%= @event.subject %>
<% else -%>
<%= @event.subject %>
<% end -%>
<% if @event.summary.present? -%>

<%= @event.summary %>
<% end -%>
<% url = if @event.vps
           webui_url("?page=adminvps&action=info&veid=#{@event.vps.id}")
         else
           webui_url("?page=notifications&action=event_show&id=#{@event.id}")
         end -%>
<% if url.present? -%>

Link: <%= url %>
<% end -%>
