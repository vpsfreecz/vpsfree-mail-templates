<% subject = ERB::Util.html_escape(@event.subject.to_s) -%>
<b><%= subject %></b>
<% if @event.summary.present? -%>

<%= ERB::Util.html_escape(@event.summary.to_s) %>
<% end -%>
<% if @event.vps -%>
<% vps_label = "##{@event.vps.id} #{@event.vps.hostname}" -%>
<% vps_url = webui_url("?page=adminvps&action=info&veid=#{@event.vps.id}") -%>

VPS: <% if vps_url.present? -%><a href="<%= ERB::Util.html_escape(vps_url.to_s) %>"><%= ERB::Util.html_escape(vps_label) %></a><% else -%><%= ERB::Util.html_escape(vps_label) %><% end -%>
<% end -%>
<% url = webui_url("?page=notifications&action=event_show&id=#{@event.id}") -%>
<% if url.present? -%>

Open: <a href="<%= ERB::Util.html_escape(url.to_s) %>">event detail</a>
<% end -%>
