<% vps_link = webui_link('open in vpsAdmin', "?page=adminvps&action=info&veid=#{@vps.id}") -%>
<% stop_vps = @expansion.respond_to?(:stop_vps) && @expansion.stop_vps -%>
<b>VPS <%= h(@vps.hostname) %> (#<%= @vps.id %>): dataset expanded</b>

Added space: <code><%= (@expansion.added_space / 1024.0).round %> GiB</code>
Dataset: <code><%= h(@dataset.full_name) %></code>
Original size: <code><%= (@expansion.original_refquota / 1024.0).round %> GiB</code>
New size: <code><%= (@dataset.refquota / 1024.0).round %> GiB</code>
Used space: <code><%= (@dataset.referenced / 1024.0).round(2) %> GiB</code>
Expansion count: <code><%= @expansion.expansion_count %><% if stop_vps -%>/3<% end -%></code>
<% if @expansion.enable_shrink -%>
Shrink: available in vpsAdmin after usage drops below <code><%= ((@expansion.original_refquota / 1024.0 / 100) * 95).round(2) %> GiB</code>
<% end -%>
<% if vps_link.present? -%>

Link: <%= vps_link %>
<% end -%>
