VPS <%= @vps.hostname %> (#<%= @vps.id %>): DNS resolver changed

<% if @old_dns_resolver.id == @new_dns_resolver.id -%>
Resolver: <%= @new_dns_resolver.label %>
<% else -%>
Old resolver: <%= @old_dns_resolver.label %>
New resolver: <%= @new_dns_resolver.label %>
<% end -%>
New addresses:
<% @new_dns_resolver.addrs.to_s.split(',').each do |addr| -%>
- <%= addr.strip %>
<% end -%>
<% vps_url = webui_url("?page=adminvps&action=info&veid=#{@vps.id}") -%>
<% if vps_url.present? -%>

Link: <%= vps_url %>
<% end -%>
