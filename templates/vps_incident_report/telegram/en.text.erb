VPS <%= @vps.hostname %> (#<%= @vps.id %>): incident report #<%= @incident.id %>

Subject: <%= @incident.subject %>
<% if @incident.ip_address -%>
IP address: <%= @incident.ip_address.to_s %>
<% end -%>
<% if @incident.cpu_limit -%>
CPU limit: <%= @incident.cpu_limit %> %
<% end -%>
<% if @incident.vps_action.present? -%>
Action: <%= @incident.vps_action %>
<% end -%>
<% if @incident.text.present? -%>
Message:
<%= @incident.text %>
<% end -%>
<% if @incident.codename -%>
KB: https://kb.vpsfree.org/manuals/vps/incidents#<%= @incident.codename %>
<% end -%>
<% vps_url = webui_url("?page=adminvps&action=info&veid=#{@vps.id}") -%>
<% if vps_url.present? -%>

Link: <%= vps_url %>
<% end -%>
<% if defined?(@mute_url) && @mute_url.present? -%>

Mute similar incident reports: <%= @mute_url %>
<% end -%>
