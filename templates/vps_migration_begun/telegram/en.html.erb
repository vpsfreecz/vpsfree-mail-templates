<% vps_link = webui_link('open in vpsAdmin', "?page=adminvps&action=info&veid=#{@vps.id}") -%>
<b>VPS <%= h(@vps.hostname) %> (#<%= @vps.id %>): migration started</b>

From: <code><%= h(@src_node.domain_name) %></code>
To: <code><%= h(@dst_node.domain_name) %></code>
<% if @maintenance_window -%>
Window: maintenance window
<% elsif @custom_window -%>
<% days = %w[Sunday Monday Tuesday Wednesday Thursday Friday Saturday] -%>
Window: custom, finishes <%= days[@finish_weekday.to_i] %> from <%= sprintf('%02d:%02d', @finish_minutes.to_i / 60, @finish_minutes.to_i % 60) %>
<% end -%>
<% if @reason.present? -%>
Reason: <%= h(@reason) %>
<% end -%>
<% if vps_link.present? -%>

Link: <%= vps_link %>
<% end -%>
