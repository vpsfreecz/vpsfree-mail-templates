<% vps_link = webui_link('open in vpsAdmin', "?page=adminvps&action=info&veid=#{@vps.id}") -%>
<% reason = @reason || (@m.respond_to?(:migration_plan) && @m.migration_plan&.reason) -%>
<b>VPS <%= h(@vps.hostname) %> (#<%= @vps.id %>): migration planned</b>

From: <code><%= h(@src_node.domain_name) %></code>
To: <code><%= h(@dst_node.domain_name) %></code>
Window: <%= @m.maintenance_window ? 'maintenance window' : 'scheduled by administrators' %>
<% if reason.present? -%>
Reason: <%= h(reason) %>
<% end -%>
<% if vps_link.present? -%>

Link: <%= vps_link %>
<% end -%>
