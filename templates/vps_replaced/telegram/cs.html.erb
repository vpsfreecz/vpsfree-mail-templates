<% link_vps = @new_vps || @original_vps -%>
<% vps_link = link_vps && webui_link('otevřít ve vpsAdminu', "?page=adminvps&action=info&veid=#{link_vps.id}") -%>
<b>VPS <%= h(@original_vps.hostname) %> (#<%= @original_vps.id %>): nahrazeno</b>

Původní VPS: <code>#<%= @original_vps.id %> <%= h(@original_vps.hostname) %></code>
<% if @new_vps -%>
Nové VPS: <code>#<%= @new_vps.id %> <%= h(@new_vps.hostname) %></code>
<% end -%>
<% if @reason.present? -%>
Důvod: <%= h(@reason) %>
<% end -%>
<% if vps_link.present? -%>

Odkaz: <%= vps_link %>
<% end -%>
